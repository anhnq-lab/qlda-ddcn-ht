# CẤU HÌNH BIẾN MÔI TRƯỜNG BẢO MẬT GOTRUE (SUPABASE AUTH)
# ĐÁP ỨNG QCVN 12:2026/BCA - ĐIỀU 2.2.7 & ĐIỀU 3.6.2

# ── 1. ĐỊNH DANH VÀ KẾT NỐI HỆ THỐNG
API_EXTERNAL_URL=https://qlda.bqlddcn.gov.vn/auth/v1
POSTGRES_PASSWORD=MatKhauDatabaseBaoMatCucCao2026!
JWT_SECRET=ChuoiSecretKeySieuBaoMatChoHeThongQLDA2026!

# ── 2. XÁC THỰC ĐA NHÂN TỐ (MFA) - ĐIỀU 3.7.2.8.3
# Bắt buộc kích hoạt MFA đối với kết nối từ Internet và tài khoản quản trị
GOTRUE_MFA_ENABLED=true
GOTRUE_MFA_MAX_FACTORS_PER_USER=3
# Quy định thuật toán mã hóa MFA (TOTP) sử dụng SHA-1 hoặc SHA-256
GOTRUE_MFA_TOTP_ALGORITHM=SHA1
GOTRUE_MFA_TOTP_PERIOD=30

# ── 3. KHÓA PHIÊN LÀM VIỆC (SESSION TIMEOUT) - ĐIỀU 3.6.2.1.8
# Thời hạn sống của mã token JWT (Access Token). Hết thời gian này, client buộc phải refresh token.
# Đối với hệ thống lưu trữ thông tin nhạy cảm của Nhà nước:
# - Phiên tác nghiệp thông thường: tối đa 15 phút (900 giây).
# - Phiên quản trị viên: tối đa 5 phút (300 giây).
GOTRUE_JWT_EXP=900

# ── 4. CHỐNG TẤN CÔNG BRUTE FORCE & KHÓA TÀI KHOẢN - ĐIỀU 3.6.2.1.9
# Phát hiện và chặn đăng nhập sai nhiều lần liên tiếp
GOTRUE_SECURITY_BRUTE_FORCE_DETECTION=true

# Số lần nhập sai mật khẩu tối đa liên tiếp cho phép (QCVN 12 quy định tối đa 5 lần đối với phần mềm nghiệp vụ)
GOTRUE_SECURITY_MAX_LOGIN_ATTEMPTS=5

# Thời gian tự động khóa tài khoản (QCVN 12 quy định thời gian khóa tối thiểu 12 giờ và tối đa 30 ngày)
# 43200 giây = 12 giờ
GOTRUE_SECURITY_LOCKOUT_DURATION=43200

# Yêu cầu người dùng xác thực lại mật khẩu hiện tại trước khi thay đổi email hoặc mật khẩu mới
GOTRUE_SECURITY_UPDATE_PASSWORD_REQUIRE_REAUTHENTICATION=true

# Vô hiệu hóa tài khoản mặc định (như signup tự do không qua phê duyệt)
GOTRUE_DISABLE_SIGNUP=true

# ── 5. CẤU HÌNH KẾT NỐI FPT OBJECT STORAGE (MÃ HÓA KẾT NỐI - ĐIỀU 2.2.16.2.2)
FPT_STORAGE_ACCESS_KEY=fpt_cloud_storage_access_key_xyz
FPT_STORAGE_SECRET_KEY=fpt_cloud_storage_secret_key_abc
FPT_STORAGE_REGION=hn-1
FPT_STORAGE_ENDPOINT=https://storage.fptcloud.com
